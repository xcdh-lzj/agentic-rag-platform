# 复制本文件为 .env，然后任选【一种】模型配置取消注释即可。

# ----------------------------------------------------------------
# 方案一：本地 Ollama（免费，需先安装并 ollama pull 模型）
# ----------------------------------------------------------------
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=deepseek-r1:8b
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------
# 方案二：DeepSeek（便宜，https://platform.deepseek.com 申请 key）
# ----------------------------------------------------------------
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_API_KEY=sk-在这里填你的key
# LLM_MODEL=deepseek-chat
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------
# 方案三：智谱 GLM（GLM-4-Flash 免费，https://open.bigmodel.cn）
# ----------------------------------------------------------------
# LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# LLM_API_KEY=在这里填你的key
# LLM_MODEL=glm-4-flash
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------
# 方案四：阿里云通义千问（https://dashscope.console.aliyun.com）
# ----------------------------------------------------------------
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=sk-在这里填你的key
# LLM_MODEL=qwen-plus
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.1

# ----------------------------------------------------------------
# 方案五：Moonshot Kimi（https://platform.moonshot.cn）
# ----------------------------------------------------------------
# LLM_BASE_URL=https://api.moonshot.cn/v1
# LLM_API_KEY=sk-在这里填你的key
# LLM_MODEL=moonshot-v1-8k
# LLM_TIMEOUT=60
# LLM_TEMPERATURE=0.1

# ===== 备用模型（步骤2启用降级链，暂时留空）=====
LLM_BACKUP_BASE_URL=
LLM_BACKUP_API_KEY=
LLM_BACKUP_MODEL=
