# ============================================================
# agentic-rag-platform / .gitignore
#
# 总原则：凡是「能用代码或原始文档重新生成」「含密钥」「含本机私有
# 数据与路径」的东西，都不进仓库；仓库只保留源码、配置模板、
# 依赖锁定文件。
# ============================================================


# ------------------------------------------------------------
# 1. 密钥与环境变量（最高优先级，禁止提交）
#    .env.example 是模板，必须提交，所以单独用 ! 放行
# ------------------------------------------------------------
.env
.env.*
!.env.example
!.env.sample

*.pem
*.key
*.p12
*.keystore
secrets.yml
secrets.yaml
secrets.toml
credentials.json
service-account*.json


# ------------------------------------------------------------
# 2. Python 字节码与打包产物
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
wheels/
sdist/
*.egg-info/
*.egg
pip-wheel-metadata/
MANIFEST


# ------------------------------------------------------------
# 3. 虚拟环境
#    注意：.python-version 要提交（锁定 Python 版本），不要加进来
# ------------------------------------------------------------
.venv/
venv/
ENV/
env/


# ------------------------------------------------------------
# 4. 测试 / 类型检查 / 格式化的缓存与报告
# ------------------------------------------------------------
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
nosetests.xml
junit*.xml


# ------------------------------------------------------------
# 5. 知识库资料与数据层
#    data/ 下放私有文档（合同/制度/手册）与解析中间产物，
#    一律不提交；只保留 .gitkeep 占位，保证 clone 后目录结构存在
# ------------------------------------------------------------
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md


# ------------------------------------------------------------
# 6. 向量库 / 索引 / 嵌入缓存
#    这些都能由 data/ 里的原文重新构建，属于纯产物
# ------------------------------------------------------------
storage/**
!storage/**/
!storage/**/.gitkeep
!storage/**/README.md

chroma/
chroma_db/
.chroma/
qdrant_storage/
milvus_data/
weaviate_data/
pgvector_data/
*.faiss
*.index
*.idx
*.npy


# ------------------------------------------------------------
# 7. 模型权重与模型缓存（体积大，一律本地管理）
# ------------------------------------------------------------
models/
.cache/
.huggingface/
.sentence_transformers/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.bin


# ------------------------------------------------------------
# 8. 日志与临时文件
# ------------------------------------------------------------
*.log
logs/
log/
tmp/
temp/
uploads/
*.tmp
*.bak
*.orig
*.pid
*.seed


# ------------------------------------------------------------
# 9. 评测与实验产物（RAGAS / 消融实验的输出）
#    可复现的报告不入库；小而固定的评测数据集建议放
#    eval/datasets/ 并明确提交
# ------------------------------------------------------------
eval_results/
reports/
artifacts/
experiments/
wandb/
.mlruns/


# ------------------------------------------------------------
# 10. 前端（步骤 9 的 FastAPI + SSE 页面若引入 Node 工具链）
# ------------------------------------------------------------
node_modules/
.next/
out/
.npm/
.pnpm-store/
.parcel-cache/
.vite/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*


# ------------------------------------------------------------
# 11. 容器与部署（步骤 14/15 的数据卷、备份包）
# ------------------------------------------------------------
docker/volumes/
pgdata/
redis-data/
minio-data/
*.tar
*.tar.gz


# ------------------------------------------------------------
# 12. Notebook 检查点
# ------------------------------------------------------------
.ipynb_checkpoints/


# ------------------------------------------------------------
# 13. 编辑器 / 操作系统 / 工具产物
#     如需团队共享 PyCharm 运行配置，可再放行 .idea/runConfigurations/
# ------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~

.DS_Store
._*
.Spotlight-V100/
.Trashes/
.fseventsd/
Thumbs.db
desktop.ini

.dsh-plots/


# ------------------------------------------------------------
# 14. 必须提交的文件（此处显式放行，防止上面的宽规则误伤）
# ------------------------------------------------------------
!uv.lock
!pyproject.toml
!README.md
!.python-version
!.gitignore
